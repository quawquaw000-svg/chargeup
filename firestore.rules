rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function bookingHasSlot(date, bookingId, booking, lesson) {
      return booking.start > lesson || booking.end < lesson
        || (
          existsAfter(/databases/$(database)/documents/days/$(date)/lessons/$(lesson)/cables/$(booking.cables[lesson - booking.start]))
          && getAfter(/databases/$(database)/documents/days/$(date)/lessons/$(lesson)/cables/$(booking.cables[lesson - booking.start])).data.bookingId == bookingId
          && getAfter(/databases/$(database)/documents/days/$(date)/lessons/$(lesson)/cables/$(booking.cables[lesson - booking.start])).data.owner == booking.owner
        );
    }

    function bookingHasAllSlots(date, bookingId, booking) {
      return bookingHasSlot(date, bookingId, booking, 1)
        && bookingHasSlot(date, bookingId, booking, 2)
        && bookingHasSlot(date, bookingId, booking, 3)
        && bookingHasSlot(date, bookingId, booking, 4)
        && bookingHasSlot(date, bookingId, booking, 5)
        && bookingHasSlot(date, bookingId, booking, 6)
        && bookingHasSlot(date, bookingId, booking, 7)
        && bookingHasSlot(date, bookingId, booking, 8)
        && bookingHasSlot(date, bookingId, booking, 9);
    }

    function bookingHasQuota(date, bookingId, booking) {
      let quotaPath = /databases/$(database)/documents/days/$(date)/bookingLimits/$(request.auth.uid);
      return booking.limitSlot in ['1', '2']
        && existsAfter(quotaPath)
        && getAfter(quotaPath).data.uid == request.auth.uid
        && getAfter(quotaPath).data.count >= int(booking.limitSlot)
        && getAfter(quotaPath).data.lastBookingId == bookingId;
    }

    function bookingHasPromo(date, bookingId, booking) {
      let promoPath = /databases/$(database)/documents/promos/$(booking.promoCode);
      return booking.promoCode is string
        && booking.promoCode.matches('^[A-Z0-9-]{4,24}$')
        && booking.freeLessons is int
        && exists(promoPath)
        && (
          (
            get(promoPath).data.type == 'monthly'
            && get(promoPath).data.expiresAt > request.time
            && booking.date == date
            && booking.freeLessons == booking.end - booking.start + 1
            && !('limitSlot' in booking)
          )
          || (
            get(promoPath).data.type == 'single'
            && get(promoPath).data.redeemed == false
            && booking.start == booking.end
            && booking.freeLessons == 1
            && booking.limitSlot in ['1', '2']
            && existsAfter(promoPath)
            && getAfter(promoPath).data.redeemed == true
            && getAfter(promoPath).data.redeemedBookingId == bookingId
            && getAfter(promoPath).data.redeemedAt == request.time
          )
        );
    }

    function bookingHasValidPayment(date, bookingId, booking) {
      return (
        ('promoCode' in booking && bookingHasPromo(date, bookingId, booking))
        || (!('promoCode' in booking) && !('freeLessons' in booking) && bookingHasQuota(date, bookingId, booking))
      );
    }

    function singlePromoHasValidBooking() {
      let bookingPath = /databases/$(database)/documents/days/$(request.resource.data.redeemedDate)/bookings/$(request.resource.data.redeemedBookingId);
      let quotaPath = /databases/$(database)/documents/days/$(request.resource.data.redeemedDate)/bookingLimits/$(request.auth.uid);
      return existsAfter(bookingPath)
        && getAfter(bookingPath).data.date == request.resource.data.redeemedDate
        && getAfter(bookingPath).data.uid == request.auth.uid
        && getAfter(bookingPath).data.promoCode == resource.data.code
        && getAfter(bookingPath).data.freeLessons == 1
        && getAfter(bookingPath).data.limitSlot in ['1', '2']
        && existsAfter(quotaPath)
        && getAfter(quotaPath).data.uid == request.auth.uid
        && getAfter(quotaPath).data.count >= int(getAfter(bookingPath).data.limitSlot)
        && getAfter(quotaPath).data.lastBookingId == request.resource.data.redeemedBookingId;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /promos/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.code == code
        && request.resource.data.code.matches('^[A-Z0-9-]{4,24}$')
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.type == 'single'
            && request.resource.data.keys().hasOnly(['code', 'type', 'createdAt', 'redeemed'])
            && request.resource.data.redeemed == false
          )
          || (
            request.resource.data.type == 'monthly'
            && request.resource.data.keys().hasOnly(['code', 'type', 'createdAt', 'expiresAt'])
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
          )
        );
      allow update: if signedIn()
        && resource.data.type == 'single'
        && resource.data.redeemed == false
        && request.resource.data.keys().hasOnly([
          'code', 'type', 'createdAt', 'redeemed', 'redeemedBookingId', 'redeemedDate', 'redeemedAt'
        ])
        && request.resource.data.code == resource.data.code
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.redeemed == true
        && request.resource.data.redeemedBookingId is string
        && request.resource.data.redeemedDate is string
        && request.resource.data.redeemedAt == request.time
        && singlePromoHasValidBooking();
      allow delete: if isAdmin();
    }

    match /days/{date}/bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'date', 'uid', 'name', 'className', 'start', 'end',
          'owner', 'status', 'cables', 'limitSlot', 'createdAt', 'promoCode', 'freeLessons'
        ])
        && request.resource.data.id == bookingId
        && (
          ('promoCode' in request.resource.data && request.resource.data.date == date)
          || (!('promoCode' in request.resource.data)
            && (!('date' in request.resource.data) || request.resource.data.date == date))
        )
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.className is string
        && request.resource.data.className.size() > 0
        && request.resource.data.className.size() <= 24
        && request.resource.data.start is int
        && request.resource.data.end is int
        && request.resource.data.start >= 1
        && request.resource.data.end <= 9
        && request.resource.data.end >= request.resource.data.start
        && request.resource.data.owner in ['Vincent', 'Max']
        && request.resource.data.status == 'active'
        && request.resource.data.cables is list
        && request.resource.data.cables.size() == request.resource.data.end - request.resource.data.start + 1
        && request.resource.data.cables.toSet().hasOnly(['1', '2', '3', '4'])
        && request.resource.data.createdAt == request.time
        && bookingHasAllSlots(date, bookingId, request.resource.data)
        && bookingHasValidPayment(date, bookingId, request.resource.data);
      allow update: if isAdmin()
        && resource.data.status == 'active'
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    match /days/{date}/lessons/{lessonId}/cables/{cableId} {
      allow read: if signedIn();
      allow create: if (isAdmin()
        && request.resource.data.keys().hasOnly(['owner', 'restricted'])
        && request.resource.data.owner in ['Vincent', 'Max']
        && request.resource.data.restricted == true
        && ((request.resource.data.owner == 'Vincent' && cableId in ['1', '2'])
          || (request.resource.data.owner == 'Max' && cableId in ['3', '4']))
      ) || (signedIn()
        && lessonId in ['1', '2', '3', '4', '5', '6', '7', '8', '9']
        && cableId in ['1', '2', '3', '4']
        && request.resource.data.keys().hasOnly(['bookingId', 'owner'])
        && request.resource.data.bookingId is string
        && request.resource.data.owner in ['Vincent', 'Max']
        && (
          (request.resource.data.owner == 'Vincent' && cableId in ['1', '2'])
          || (request.resource.data.owner == 'Max' && cableId in ['3', '4'])
        )
        && !exists(/databases/$(database)/documents/days/$(date)/blocked/$(lessonId))
        && existsAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId)).data.owner == request.resource.data.owner
        && getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId)).data.start <= int(lessonId)
        && getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId)).data.end >= int(lessonId)
        && getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId)).data.cables[int(lessonId) - getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId)).data.start] == cableId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /days/{date}/bookingLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['bookingId', 'lastBookingId', 'uid', 'count', 'updatedAt'])
        && request.resource.data.count == 1
        && request.resource.data.bookingId is string
        && request.resource.data.lastBookingId == request.resource.data.bookingId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.bookingId)).data.limitSlot == '1';
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && resource.data.count == 1
        && request.resource.data.count == 2
        && request.resource.data.keys().hasOnly(['bookingId', 'lastBookingId', 'uid', 'count', 'updatedAt'])
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.lastBookingId is string
        && request.resource.data.lastBookingId != resource.data.lastBookingId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.lastBookingId))
        && getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.lastBookingId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/days/$(date)/bookings/$(request.resource.data.lastBookingId)).data.limitSlot == '2';
      allow delete: if false;
    }

    match /days/{date}/blocked/{lessonId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && lessonId in ['1', '2', '3', '4', '5', '6', '7', '8', '9']
        && request.resource.data.keys().hasOnly(['lesson'])
        && request.resource.data.lesson == int(lessonId);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
